# Окружение: local | test | staging | production
ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://crewboard:crewboard@db:5432/crewboard
REDIS_URL=redis://redis:6379/0

# Только для разработки: сгенерируйте свой секрет (>= 32 символов) для staging/production
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Публичный адрес фронтенда (ссылки в письмах, return_url) и адрес api внутри сети compose
PUBLIC_URL=http://localhost:5173
API_INTERNAL_URL=http://api:8000

# Платежи: mock (по умолчанию, ключи не нужны) | yookassa
PAYMENT_PROVIDER=mock
WEBHOOK_SECRET=dev-only-webhook-secret-change-me-0123456789
MOCK_WEBHOOK_DUPLICATE_RATE=0.2
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Вход через GitHub включается, только если оба значения заданы
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Почта (mailpit из docker compose, веб-интерфейс на :8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=Crewboard <noreply@crewboard.local>

# Dev-эндпоинты (сдвиг часов). При ENV=staging/production приложение с этим флагом не стартует
DEV_ENDPOINTS=true

# Лимиты запросов в минуту
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_RESET_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_DEMO_PER_MINUTE=10

# Порты на хосте
API_PORT=8000
WEB_PORT=5173
MAILPIT_PORT=8025
